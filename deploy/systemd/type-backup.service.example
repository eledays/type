[Unit]
Description=Back up type PostgreSQL, verify restore, and enforce data retention
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=type
Group=type
WorkingDirectory=/opt/type
EnvironmentFile=-/etc/type-backup.env
ExecStart=/opt/type/scripts/backup_postgres.sh
ExecStart=/opt/type/scripts/restore_test_postgres.sh
ExecStart=/opt/type/scripts/compose_production.sh exec -T app flask --app app cleanup_anonymous
