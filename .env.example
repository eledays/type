# Flask settings
DEBUG=true
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///app.db
FLASK_PORT=5000
FLASK_HOST=localhost
MAX_CONTENT_LENGTH=65536
# Comma-separated host names accepted in the Host header.
# Defaults to URL's host in production and loopback hosts in DEBUG mode.
# TRUSTED_HOSTS=type.eleday.ru

# Automatically true outside DEBUG mode when omitted.
# COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_DAYS=30
# HSTS_ENABLED=true

# OAuth settings (https://oauth.yandex.ru/)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:5000/auth/yandex/callback

# Number of answers/skips available before a guest must sign in.
ANONYMOUS_ACTION_LIMIT=30

# Feed pool size and the largest limit accepted by the batch API.
PRACTICE_CARD_BATCH_SIZE=3
PRACTICE_CARD_BATCH_MAX=12
PRACTICE_DIFFICULT_CANDIDATE_LIMIT=50
PRACTICE_SWIPE_GRACE_STRIKE=3

# Per-route, application-wide, and sensitive endpoint rate limits.
RATE_LIMIT_DEFAULT=300 per minute
RATE_LIMIT_APPLICATION=3000 per hour
RATE_LIMIT_AUTH=10 per minute
RATE_LIMIT_MUTATION=120 per minute
RATE_LIMIT_REPORT=5 per hour

# Production startup requires shared storage such as redis://localhost:6379/0.
RATE_LIMIT_STORAGE_URI=memory://

# Set to the exact number of trusted reverse proxies in front of Flask.
TRUSTED_PROXY_COUNT=0
