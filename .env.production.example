# Copy to .env.production on the server and replace every placeholder.
# Use URL-safe hexadecimal values for secrets embedded into DATABASE_URL.
DOMAIN=type.eleday.ru
# Private/VPN address of this application server. Apache connects to this IP.
APP_BIND_IP=10.0.0.20
APP_PORT=8000

SECRET_KEY=replace-with-openssl-rand-hex-32
POSTGRES_DB=type
POSTGRES_USER=type
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

YANDEX_CLIENT_ID=replace-with-yandex-client-id
YANDEX_CLIENT_SECRET=replace-with-yandex-client-secret
